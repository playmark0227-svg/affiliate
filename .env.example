# Required: Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Required: Amazon Associates (Japan)
AMAZON_ASSOCIATE_TAG=yourtag-22

# Optional: Rakuten Affiliate
RAKUTEN_AFFILIATE_ID=

# Optional: A8.net (paste a generated link template here, or leave blank)
A8_LINK_TEMPLATE=

# Optional: Moshimo Affiliate (easier approval, covers Yahoo!ショッピング)
# Find this as a_id on https://af.moshimo.com after registering
MOSHIMO_ID=

# Optional: ValueCommerce (paste a campaign-specific link template)
VALUECOMMERCE_LINK_TEMPLATE=

# Optional: X (Twitter) for auto-posting
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Site config
SITE_BASE_URL=https://YOUR-USERNAME.github.io/affiliate
SITE_TITLE=お得レビューラボ
SITE_DESCRIPTION=AIが選ぶ、本当に役立つ商品レビュー

# Optional: GitHub Pages custom domain (e.g. example.com or blog.example.com)
# When set, build emits site/CNAME automatically.
SITE_CUSTOM_DOMAIN=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# Optional: Google Search Console / Bing Webmaster site verification meta tag values
# Paste only the content="..." part from the HTML tag option.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: Discord webhook URL to announce new posts
DISCORD_WEBHOOK_URL=

# Tuning
ARTICLES_PER_RUN=2
MODEL=claude-opus-4-8
# Reasoning depth / cost tradeoff: low | medium | high | xhigh | max
EFFORT=high
